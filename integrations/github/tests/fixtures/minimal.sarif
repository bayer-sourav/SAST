{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "rules": [{ "id": "java/xss" }]
        }
      },
      "results": [
        {
          "ruleId": "java/xss",
          "message": { "text": "Cross-site scripting vulnerability." },
          "partialFingerprints": {
            "primaryLocationLineHash": "abc123:1"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "%SRCROOT%/src/main/App.java",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": { "startLine": 42, "endLine": 44 }
              }
            }
          ],
          "codeFlows": [
            {
              "threadFlows": [
                {
                  "locations": [
                    {
                      "location": {
                        "physicalLocation": {
                          "artifactLocation": { "uri": "%SRCROOT%/src/main/Input.java" },
                          "region": { "startLine": 10, "endLine": 12 }
                        }
                      },
                      "taxa": [{ "properties": { "CodeQL/DataflowRole": "source" } }]
                    },
                    {
                      "location": {
                        "physicalLocation": {
                          "artifactLocation": { "uri": "%SRCROOT%/src/main/App.java" },
                          "region": { "startLine": 42, "endLine": 44 }
                        }
                      },
                      "taxa": [{ "properties": { "CodeQL/DataflowRole": "sink" } }]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
