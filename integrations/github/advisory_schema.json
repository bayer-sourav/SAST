{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sast.local/schemas/advisory-v1.json",
  "title": "AdvisoryTriageFinding",
  "type": "object",
  "required": [
    "alert_fingerprint",
    "rule_id",
    "file",
    "start_line",
    "advisory",
    "provenance"
  ],
  "properties": {
    "alert_fingerprint": {
      "type": "string",
      "description": "Stable id from SARIF partialFingerprints or hash"
    },
    "rule_id": {
      "type": "string"
    },
    "file": {
      "type": "string",
      "description": "Repo-relative path"
    },
    "start_line": {
      "type": "integer",
      "minimum": 1
    },
    "end_line": {
      "type": "integer",
      "minimum": 1
    },
    "advisory": {
      "type": "object",
      "required": ["label", "confidence", "reason"],
      "properties": {
        "label": {
          "type": "string",
          "enum": ["TP", "FP", "BL", "UNKNOWN"]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "confidence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "lines", "note"],
            "properties": {
              "file": { "type": "string" },
              "lines": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        },
        "ui_headline": {
          "type": "string",
          "description": "Human-facing advisory text for GitHub annotation"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["model_profile", "prompt_version", "manifest_id"],
      "properties": {
        "model_profile": { "type": "string" },
        "lora_checkpoint": { "type": "string" },
        "prompt_version": { "type": "string" },
        "manifest_id": { "type": "string" },
        "inferred_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
