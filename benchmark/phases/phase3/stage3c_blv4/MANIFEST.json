    "vdr": 0.903,
    "srs": 0.899,
    "epoch": 4,
    "source": "runs/phase3/stage3b/lora/best_fs0_off"
  },
  "success_gates": {
    "primary": "beat Stage 2 SRS on 600-case Phase 2 test (fs0_off)",
    "fprr_target": 0.735,
    "vdr_floor": 0.9,
    "monitor": [
      "fprr",
      "critical_tp_fp"
    ]
  },
  "outputs": {
    "teacher_cache": "runs/phase3/stage3b/teacher/train",
    "sft_data": "runs/phase3/stage3c_blv4/data",
    "lora": "runs/phase3/stage3c_blv4/lora",
    "val_eval": "runs/phase3/stage3c_blv4/val_eval",
    "test_eval": "runs/phase3/stage3c_blv4/eval",
    "summaries": "runs/phase3/stage3c_blv4/summaries",
    "css_eligible_registry": "runs/phase3/stage3c_blv4/summaries/css_eligible.json",
    "global_best": "runs/phase3/stage3c_blv4/lora/best"
  },
  "scripts": [
    "export_distill_dataset.py",
    "run_unsloth_lora_css.py",
    "eval_val_for_css.py",
    "rerank_val_checkpoints.py",
    "run_phase3c.sh",
    "run_phase3_eval.sh"
  ],
  "protocol": {
    "frozen_recipe": true,
    "no_hyperparam_search": true,
    "single_test_eval_on_best_only": true,
    "base_run": "runs/phase3/stage3c",
    "bl_tier": "curated_v4_calibrated_v3",
