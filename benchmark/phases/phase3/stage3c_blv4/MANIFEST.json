{
  "stage": "phase3c_blv4",
  "status": "running",
  "description": "Confirmatory 3C re-run: frozen recipe on latest BL synthetic (curated_v4_calibrated_v3 / BenchmarkTest28xxx). Original stage3c distill used retired BLSynthetic* IDs.",
  "hypothesis": "Same 3C ship-aligned distill (v7-ship fs0 json_only, Stage 2 teacher) on current BL train/val should confirm whether 3C metrics hold after BL corpus refresh.",
  "base_model": {
    "profile": "qwen3_5_9b_bnb",
    "unsloth_id": "unsloth/Qwen3.5-9B",
    "quantization": "4bit"
  },
  "teacher": {
    "source": "runs/phase2/stage2",
    "cell_id": "5.9b_fs3_legacy",
    "profile": "qwen3_5_9b_bnb",
    "prompt_version": "v7-balanced",
    "thinking": true,
    "fewshot": 3,
    "few_shot_config": "v2_3shot_tp_2fp",
    "runs_on_splits": [
      "train"
    ],
    "note": "Reuse stage3b FP/TP teacher cache; re-infer missing FP/TP + full current BL train (BenchmarkTest28xxx)."
  },
  "dataset": {
    "root": "../SAST-Benchmark-Dataset/BenchmarkJava",
    "train_per_class": 500,
    "validation_per_class": 200,
    "test_per_class": 200,
    "sft_split": "train",
    "sft_n_expected": 1500,
    "val_split": "validation",
    "val_n_expected": 600,
    "eval_corpora": {
      "fp": "benchmark/corpora/phase2_fp_test",
      "tp": "benchmark/corpora/phase2_tp_test",
      "borderline": "benchmark/corpora/phase2_bl_test"
    },
    "leakage_rule": "Phase 2 test case IDs must never appear in train SFT or val CSS runs"
  },
  "supervision": {
    "mode": "teacher_distill",
    "split": "train",
    "fallback": "drop_case_if_teacher_missing",
    "target": "json_only",
    "label_policy": "teacher_label",
    "note": "Assistant turn is compact JSON parsed from teacher CoT+JSON output."
  },
  "train_prompt": {
    "prompt_version": "v7-ship",
    "language_agnostic_ship": true,
    "thinking": false,
    "fewshot": 0,
    "few_shot_config": "v2_3shot_tp_2fp"
  },
  "inference_eval": {
    "profile": "qwen3_5_9b_bnb",
    "prompt_version": "v7-ship",
    "thinking": false,
    "fewshot": 0,
    "few_shot_config": "v2_3shot_tp_2fp",
    "metrics": [
      "srs",
      "vdr",
      "fprr",
      "macro_f1",
      "css",
      "confusion_matrix"
    ],
    "note": "Val CSS and test eval both use ship config \u2014 no train/serve mismatch."
  },
  "css": {
    "formula": "0.35*SRS + 0.35*VDR + 0.20*FPRR + 0.10*Macro-F1",
    "disqualify_if_vdr_below": 0.75,
    "implementation": "benchmark/css.py",
    "used_for": [
      "checkpoint_selection",
      "global_best_pick"
    ],
    "not_used_for": [
      "final_ship_metric"
    ]
  },
  "checkpoint_selection": {
    "during_training": {
      "eval_split": "validation",
      "eval_every_epochs": 2,
      "save_all_epochs": true,
      "track_css_eligible": true,
      "early_stop_patience_evals": 3,
      "per_rank": true
    },
    "after_training": {
      "rerank_all_css_eligible_on_validation": true,
      "pick_global_best_by": "css",
      "single_test_eval_on_best_only": true
    }
  },
  "lora_rank_sweep": {
    "ranks": [
      32
    ],
    "rationale": "r=32 proven in 3B; add 64 only if 3C FPRR misses gate.",
    "alpha_equals_r": true,
    "sequential_only": true,
    "gpu": "NVIDIA L40S 46GB"
  },
  "performance": {
    "base_model": "qwen3_5_9b_bnb",
    "train": {
      "max_seq_len": 12288,
      "packing": true,
      "unsloth_import_first": true
    },
    "css_val_during_training": {
      "mode": "fast",
      "n_cases": 150,
      "per_track": 50,
      "seed": 3407
    },
    "css_val_rerank": {
      "mode": "full",
      "n_cases": 600
    },
    "inference": {
      "in_process_batch": true,
      "max_new_tokens_thinking_off": 4096
    }
  },
  "hyperparameters": {
    "epochs_max": 10,
    "epochs_stop_by": "css_early_stop",
    "early_stop_patience_evals": 3,
    "learning_rate": 5e-05,
    "batch_size": 1,
    "grad_accum": 8,
    "max_seq_len": 12288,
    "warmup_ratio": 0.03
  },
  "baseline_stage2": {
    "fprr": 0.735,
    "vdr": 0.925,
    "srs": 0.925,
    "source": "runs/phase2/stage2 \u00b7 5.9b_fs3_legacy"
  },
  "baseline_phase3b_ship": {
