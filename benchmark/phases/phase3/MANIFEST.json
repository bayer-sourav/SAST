{
  "phase": "phase3a",
  "description": "LoRA SFT on Qwen3.5-9B (Java train split); eval on Phase 2 held-out test",
  "base_model": {
    "profile": "qwen3_5_9b_bnb",
    "unsloth_id": "unsloth/Qwen3.5-9B",
    "quantization": "4bit"
  },
  "dataset": {
    "root": "../SAST-Benchmark-Dataset/BenchmarkJava",
    "train_per_class": 500,
    "validation_per_class": 200,
    "test_per_class": 200,
    "sft_split": "train",
    "sft_n_expected": 1500,
    "eval_corpora": {
      "fp": "benchmark/corpora/phase2_fp_test",
      "tp": "benchmark/corpora/phase2_tp_test",
      "borderline": "benchmark/corpora/phase2_bl_test"
    }
  },
  "train_labels": {
    "fp": "FP",
    "tp": "TP",
    "borderline": "BL"
  },
  "inference_eval": {
    "profile": "qwen3_5_9b_bnb",
    "prompt_version": "v7-balanced",
    "thinking": true,
    "fewshot": 3,
    "few_shot_config": "v2_3shot_tp_2fp"
  },
  "baseline_stage2": {
    "fprr": 0.735,
    "vdr": 0.925,
    "srs": 0.925,
    "source": "runs/phase2/stage2/summaries/STAGE2_REPORT.md"
  },
  "success_gates": {
    "primary": "beat Stage 2 SRS on 600-case Phase 2 test",
    "monitor": ["vdr", "fprr"]
  },
  "outputs": {
    "sft_data": "runs/phase3/stage3a/data",
    "lora": "runs/phase3/stage3a/lora",
    "eval": "runs/phase3/stage3a/eval",
    "summaries": "runs/phase3/stage3a/summaries"
  }
}
