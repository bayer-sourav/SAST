{
  "stage": "phase3b",
  "status": "complete_primary",
  "description": "Stage 2 teacher distillation on train + CSS val selection + LoRA rank 32 (primary complete)",
  "hypothesis": "Distill Stage 2 teacher on train; select checkpoints by CSS on val (not loss); sweep LoRA rank.",
  "base_model": {
    "profile": "qwen3_5_9b_bnb",
    "unsloth_id": "unsloth/Qwen3.5-9B",
    "quantization": "4bit"
  },
  "teacher": {
    "source": "runs/phase2/stage2",
    "cell_id": "5.9b_fs3_legacy",
    "profile": "qwen3_5_9b_bnb",
    "prompt_version": "v7-balanced",
    "thinking": true,
    "fewshot": 3,
    "few_shot_config": "v2_3shot_tp_2fp",
    "runs_on_splits": ["train"],
    "note": "Teacher inference on train split only (1500 cases). Val CSS uses dataset gold, not teacher."
  },
  "dataset": {
    "root": "../SAST-Benchmark-Dataset/BenchmarkJava",
    "train_per_class": 500,
    "validation_per_class": 200,
    "test_per_class": 200,
    "sft_split": "train",
    "sft_n_expected": 1500,
    "val_split": "validation",
    "val_n_expected": 600,
    "eval_corpora": {
      "fp": "benchmark/corpora/phase2_fp_test",
      "tp": "benchmark/corpora/phase2_tp_test",
      "borderline": "benchmark/corpora/phase2_bl_test"
    },
    "leakage_rule": "Phase 2 test case IDs must never appear in train SFT or val CSS runs"
  },
  "supervision": {
    "mode": "teacher_distill",
    "split": "train",
    "fallback": "drop_case_if_teacher_missing",
    "include_thinking": true,
    "target": "teacher_assistant_turn",
    "label_policy": "teacher_label"
  },
  "train_prompt": {
    "prompt_version": "v7-ship",
    "language_agnostic_ship": true,
    "thinking": true,
    "fewshot": 3,
    "few_shot_config": "v2_3shot_tp_2fp"
  },
  "inference_eval": {
    "profile": "qwen3_5_9b_bnb",
    "prompt_version": "v7-ship",
    "thinking": true,
    "fewshot": 3,
    "few_shot_config": "v2_3shot_tp_2fp",
    "metrics": ["srs", "vdr", "fprr", "macro_f1", "css", "confusion_matrix"],
    "note": "Same metric suite on val (selection) and test (final report)"
  },
  "css": {
    "formula": "0.35*SRS + 0.35*VDR + 0.20*FPRR + 0.10*Macro-F1",
    "disqualify_if_vdr_below": 0.75,
    "implementation": "benchmark/css.py",
    "used_for": ["checkpoint_selection", "global_best_pick"],
    "not_used_for": ["final_ship_metric"]
  },
  "checkpoint_selection": {
    "during_training": {
      "eval_split": "validation",
      "eval_every_epochs": 1,
      "save_all_epochs": true,
      "track_css_eligible": true,
      "early_stop_patience_evals": 3,
      "per_rank": true
    },
    "after_training": {
      "rerank_all_css_eligible_on_validation": true,
      "pick_global_best_by": "css",
      "single_test_eval_on_best_only": true
    }
  },
  "lora_rank_sweep": {
    "ranks": [16, 32, 64],
    "rationale": "16=3A baseline ablation; 32=primary sweet spot; 64=CoT capacity. Skip 128: 1500-sample distill overfits, VRAM-neutral on L40S.",
    "excluded_ranks": [128],
    "alpha_equals_r": true,
    "sequential_only": true,
    "gpu": "NVIDIA L40S 46GB",
    "skip_rank_if_oom_after_truncation": true,
    "unload_trainer_before_val_eval": true
  },
  "performance": {
    "base_model": "qwen3_5_9b_bnb",
    "base_model_note": "Only Qwen3.5-9B for all 3B fine-tuning (Phase 2 GOOD ship). Qwen3-8B is not a fine-tune target.",
    "train": {
      "max_seq_len": 16384,
      "max_thinking_tokens": 4096,
      "max_seq_len_rationale": "8192 insufficient: fs3 user prompt alone ~9.5k tok p50; combined user+CoT ~13.5k p50",
      "packing": true,
      "unsloth_import_first": true,
      "fix_flash_attention_2": true
    },
    "css_val_during_training": {
      "mode": "fast",
      "n_cases": 150,
      "per_track": 50,
      "seed": 3407
    },
    "css_val_rerank": {
      "mode": "full",
      "n_cases": 600
    },
    "inference": {
      "in_process_batch": true,
      "max_new_tokens_thinking": 8192,
      "note": "Phase 3A full 600 eval ~40-50h; fast val saves ~4x during training loop"
    }
  },
  "hyperparameters": {
    "epochs_max": 10,
    "epochs_stop_by": "css_early_stop",
    "early_stop_patience_evals": 3,
    "note": "No fixed low epoch budget — train until CSS plateaus on val; 10 is a safety cap only.",
    "learning_rate": 5e-5,
    "batch_size": 1,
    "grad_accum": 8,
    "max_seq_len": 16384,
    "warmup_ratio": 0.03
  },
  "baseline_stage2": {
    "fprr": 0.735,
    "vdr": 0.925,
    "srs": 0.925,
    "source": "runs/phase2/stage2 · 5.9b_fs3_legacy"
  },
  "success_gates": {
    "primary": "beat Stage 2 SRS on 600-case Phase 2 test",
    "monitor": ["vdr", "fprr", "critical_tp_fp"]
  },
  "outputs": {
    "teacher_cache": "runs/phase3/stage3b/teacher/train",
    "sft_data": "runs/phase3/stage3b/data",
    "lora": "runs/phase3/stage3b/lora",
    "val_eval": "runs/phase3/stage3b/val_eval",
    "test_eval": "runs/phase3/stage3b/eval",
    "summaries": "runs/phase3/stage3b/summaries",
    "css_eligible_registry": "runs/phase3/stage3b/summaries/css_eligible.json",
    "global_best": "runs/phase3/stage3b/lora/best",
    "ship_best_fs0_off": "runs/phase3/stage3b/lora/best_fs0_off",
    "ship_pick_epoch": 4,
    "train_css_pick_epoch": 6
  },
  "scripts_planned": [
    "run_stage2_teacher_on_split.py",
    "export_distill_dataset.py",
    "run_unsloth_lora_css.py",
    "eval_val_for_css.py",
    "rerank_val_checkpoints.py",
    "run_phase3b.sh",
    "report_phase3_status.py"
  ]
}
